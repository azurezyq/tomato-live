# Firebase Web App Config (from Firebase Console -> Project Settings)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-gcp-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-gcp-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-gcp-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase AI Logic backend: vertexai (default) or googleai
VITE_FIREBASE_AI_BACKEND=vertexai
VITE_VERTEX_LOCATION=global

# Cloud Run / local WebSocket proxy URL for gemini-3.5-transcribe-live
VITE_STT_WS_URL=ws://localhost:8081/ws/stt

# Model IDs (overridable in UI Settings Drawer)
VITE_FAST_MODEL=gemini-3.5-flash-lite
VITE_MAIN_MODEL=gemini-4-hydrogen
VITE_TTS_MODEL=gemini-3.8-flash-lite-tts
VITE_STT_MODEL=gemini-3.5-transcribe-live
