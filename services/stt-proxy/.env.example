PORT=8081
# Use Vertex AI API via GCP Application Default Credentials (recommended)
USE_VERTEX_AI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
VERTEX_LOCATION=global
# Optional: override model ID (defaults to gemini-3.5-transcribe-live)
STT_MODEL=gemini-3.5-transcribe-live
# Only needed if USE_VERTEX_AI=false
# GEMINI_API_KEY=your-gemini-api-key
# Semicolon- or comma-separated allowed browser origins
ALLOWED_ORIGINS=http://localhost:5173
# Optional: semicolon- or comma-separated allowlist of Google account emails (empty = allow any signed-in user)
ALLOWED_EMAILS=
# Daily turn cap (resets daily at 00:00 UTC; set 0 to disable)
MAX_DAILY_TURNS=1000
# Only set true in local tests without Firebase credentials
ALLOW_DEV_BYPASS=false
